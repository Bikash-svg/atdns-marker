# ---- Server ----
PORT=5000
NODE_ENV=production

# ---- MongoDB ----
# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/attendanceApp?retryWrites=true&w=majority

# ---- JWT ----
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=30d

# ---- Email (Gmail SMTP) for password reset ----
# EMAIL_USER: your Gmail address
# EMAIL_PASS: a Gmail "App Password" (NOT your normal Gmail password)
#   Create one at https://myaccount.google.com/apppasswords
#   (requires 2-Step Verification to be enabled on the Google account)
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM="Attendance Calculator <youraddress@gmail.com>"

# ---- Frontend ----
# Used to build the password reset link that gets emailed to users
FRONTEND_URL=https://your-frontend-domain.com

# ---- CORS ----
# Comma-separated list of allowed origins for your deployed frontend
# e.g. https://your-frontend-domain.com,http://localhost:5500
ALLOWED_ORIGINS=http://localhost:5500
